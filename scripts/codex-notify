#!/usr/bin/env python3
import json
import os
import shutil
import subprocess
import sys
from pathlib import Path


SOUND_FILTER = (
    "sine=frequency=1318:sample_rate=44100:duration=0.06[a];"
    "sine=frequency=1046:sample_rate=44100:duration=0.12[b];"
    "[a][b]concat=n=2:v=0:a=1,afade=t=out:st=0.14:d=0.04"
)


def resolve_bin(*candidates: str) -> str | None:
    for candidate in candidates:
        if candidate.startswith("/") and Path(candidate).exists():
            return candidate
        found = shutil.which(candidate)
        if found:
            return found
    return None


def clean(value: object) -> str:
    if not isinstance(value, str):
        return ""
    return " ".join(value.split())


def truncate(value: str, max_length: int = 180) -> str:
    text = clean(value)
    if len(text) <= max_length:
        return text
    return text[: max_length - 3].rstrip() + "..."


def load_payload() -> dict:
    try:
        value = json.loads(sys.argv[1] if len(sys.argv) > 1 else "{}")
    except json.JSONDecodeError:
        return {}
    return value if isinstance(value, dict) else {}


def show_popup(payload: dict) -> None:
    if os.environ.get("CODEX_NOTIFY_POPUP", "1") == "0":
        return

    notify_send = resolve_bin("/run/current-system/sw/bin/notify-send", "notify-send")
    if not notify_send:
        return

    cwd = clean(payload.get("cwd"))
    project = Path(cwd).name if cwd else "Codex"
    preview = truncate(payload.get("last-assistant-message") or "The agent is done.")
    title = f"Codex: {project}"
    body = f"The agent is done.{os.linesep}{preview}" if preview else "The agent is done."
    timeout_ms = os.environ.get("CODEX_NOTIFY_TIMEOUT_MS", "12000")
    icon = os.environ.get("CODEX_NOTIFY_ICON", "com.mitchellh.ghostty")

    try:
        subprocess.Popen(
            [
                notify_send,
                "-a",
                "Codex",
                "-i",
                icon,
                "-u",
                "normal",
                "-t",
                timeout_ms,
                title,
                body,
            ],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
    except OSError:
        pass


def play_sound() -> None:
    if os.environ.get("CODEX_NOTIFY_SOUND", "1") == "0":
        return

    ffplay = resolve_bin(
        str(Path.home() / ".nix-profile" / "bin" / "ffplay"),
        "/run/current-system/sw/bin/ffplay",
        "ffplay",
    )
    if not ffplay:
        return

    volume = os.environ.get("CODEX_NOTIFY_SOUND_VOLUME", "80")
    sound_filter = os.environ.get("CODEX_NOTIFY_SOUND_FILTER", SOUND_FILTER)

    try:
        subprocess.run(
            [
                ffplay,
                "-nodisp",
                "-autoexit",
                "-loglevel",
                "quiet",
                "-volume",
                volume,
                "-f",
                "lavfi",
                sound_filter,
            ],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=5,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired):
        pass


def main() -> int:
    payload = load_payload()
    if payload.get("type") != "agent-turn-complete":
        return 0

    show_popup(payload)
    play_sound()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
