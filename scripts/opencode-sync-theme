#!/usr/bin/env python3
from __future__ import annotations

import json
from pathlib import Path

try:
    import tomllib
except ModuleNotFoundError:
    tomllib = None


OMARCHY_THEME_GHOSTTY_PATH = Path("~/.config/omarchy/current/theme/ghostty.conf").expanduser()
OMARCHY_THEME_COLORS_PATH = Path("~/.config/omarchy/current/theme/colors.toml").expanduser()
OPENCODE_THEME_DIR = Path("~/.config/opencode/themes").expanduser()
OPENCODE_THEME_PATH = OPENCODE_THEME_DIR / "omarchy.json"


def parse_colors(path: Path) -> dict[str, str]:
    if path.suffix == ".conf":
        colors: dict[str, str] = {}
        for raw_line in path.read_text(encoding="utf-8").splitlines():
            line = raw_line.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue

            key, value = [part.strip() for part in line.split("=", 1)]
            if key == "palette":
                index, color = [part.strip() for part in value.split("=", 1)]
                colors[f"color{index}"] = color
                continue

            if key == "cursor-color":
                colors["cursor"] = value
            elif key == "selection-background":
                colors["selection_background"] = value
            elif key == "selection-foreground":
                colors["selection_foreground"] = value
            else:
                colors[key.replace("-", "_")] = value
        return colors

    if tomllib is not None:
        with path.open("rb") as handle:
            data = tomllib.load(handle)
        return {key: str(value) for key, value in data.items()}

    colors: dict[str, str] = {}
    for raw_line in path.read_text(encoding="utf-8").splitlines():
        line = raw_line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, value = line.split("=", 1)
        colors[key.strip()] = value.strip().strip('"').strip("'")
    return colors


def hex_to_rgb(value: str) -> tuple[int, int, int]:
    value = value.strip().lstrip("#")
    if len(value) == 3:
        value = "".join(part * 2 for part in value)
    if len(value) != 6:
        raise ValueError(f"Unsupported color value: {value}")
    return tuple(int(value[index:index + 2], 16) for index in (0, 2, 4))


def rgb_to_hex(rgb: tuple[int, int, int]) -> str:
    return "#" + "".join(f"{max(0, min(255, channel)):02x}" for channel in rgb)


def mix(color_a: str, color_b: str, amount: float) -> str:
    rgb_a = hex_to_rgb(color_a)
    rgb_b = hex_to_rgb(color_b)
    mixed = tuple(round(a * (1 - amount) + b * amount) for a, b in zip(rgb_a, rgb_b))
    return rgb_to_hex(mixed)


def build_theme(colors: dict[str, str]) -> dict[str, object]:
    bg = colors.get("background", "#000000")
    fg = colors.get("foreground", "#ffffff")
    accent = colors.get("accent", colors.get("color4", "#5ea1ff"))
    red = colors.get("color1", "#ff6b6b")
    green = colors.get("color2", "#8bd450")
    yellow = colors.get("color3", "#f5c451")
    blue = colors.get("color4", accent)
    cyan = colors.get("color6", "#63d2ff")
    selection = colors.get("selection_background", mix(bg, fg, 0.20))

    defs = {
        "bg": bg,
        "bgPanel": mix(bg, fg, 0.08),
        "bgElement": mix(bg, fg, 0.14),
        "fg": fg,
        "fgMuted": mix(fg, bg, 0.42),
        "accent": accent,
        "accentBright": mix(accent, fg, 0.18),
        "selection": selection,
        "border": mix(bg, fg, 0.22),
        "red": red,
        "green": green,
        "yellow": yellow,
        "blue": blue,
        "cyan": cyan,
        "diffAddedBg": mix(bg, green, 0.16),
        "diffRemovedBg": mix(bg, red, 0.16),
    }

    return {
        "$schema": "https://opencode.ai/theme.json",
        "defs": defs,
        "theme": {
            "primary": "accent",
            "secondary": "accentBright",
            "accent": "accent",
            "error": "red",
            "warning": "yellow",
            "success": "green",
            "info": "blue",
            "text": "fg",
            "textMuted": "fgMuted",
            "background": "bg",
            "backgroundPanel": "bgPanel",
            "backgroundElement": "bgElement",
            "border": "border",
            "borderActive": "accent",
            "borderSubtle": "bgElement",
            "diffAdded": "green",
            "diffRemoved": "red",
            "diffContext": "fgMuted",
            "diffHunkHeader": "fgMuted",
            "diffHighlightAdded": "green",
            "diffHighlightRemoved": "red",
            "diffAddedBg": "diffAddedBg",
            "diffRemovedBg": "diffRemovedBg",
            "diffContextBg": "bgPanel",
            "diffLineNumber": "fgMuted",
            "diffAddedLineNumberBg": "diffAddedBg",
            "diffRemovedLineNumberBg": "diffRemovedBg",
            "markdownText": "fg",
            "markdownHeading": "accent",
            "markdownLink": "blue",
            "markdownLinkText": "accent",
            "markdownCode": "green",
            "markdownBlockQuote": "fgMuted",
            "markdownEmph": "fg",
            "markdownStrong": "accentBright",
            "markdownHorizontalRule": "border",
            "markdownListItem": "accent",
            "markdownListEnumeration": "blue",
            "markdownImage": "accent",
            "markdownImageText": "blue",
            "markdownCodeBlock": "fg",
            "syntaxComment": "fgMuted",
            "syntaxKeyword": "accent",
            "syntaxFunction": "blue",
            "syntaxVariable": "fg",
            "syntaxString": "green",
            "syntaxNumber": "yellow",
            "syntaxType": "cyan",
            "syntaxOperator": "fg",
            "syntaxPunctuation": "fgMuted",
        },
    }


def main() -> int:
    source_path = OMARCHY_THEME_GHOSTTY_PATH if OMARCHY_THEME_GHOSTTY_PATH.exists() else OMARCHY_THEME_COLORS_PATH

    if not source_path.exists():
        print(
            "Error: Omarchy theme file not found at "
            f"{OMARCHY_THEME_GHOSTTY_PATH} or {OMARCHY_THEME_COLORS_PATH}"
        )
        return 1

    OPENCODE_THEME_DIR.mkdir(parents=True, exist_ok=True)
    colors = parse_colors(source_path)
    theme = build_theme(colors)
    OPENCODE_THEME_PATH.write_text(json.dumps(theme, indent=2) + "\n", encoding="utf-8")
    print(f"Generated theme at {OPENCODE_THEME_PATH}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
