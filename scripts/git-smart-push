#!/bin/bash
# git-smart-push - Run gates + smart review before push
# Shows what YOU should review (learning opportunities, critical code)

set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

echo -e "${BLUE}═══════════════════════════════════════════════════${NC}"
echo -e "${BLUE}           GIT SMART PUSH                          ${NC}"
echo -e "${BLUE}═══════════════════════════════════════════════════${NC}"

# Check if there are commits to push
COMMITS=$(git log origin/$(git branch --show-current)..HEAD --oneline 2>/dev/null | wc -l)
if [[ $COMMITS -eq 0 ]]; then
  echo -e "${YELLOW}No commits to push.${NC}"
  exit 0
fi

echo -e "\n${BLUE}📦 Commits to push: ${COMMITS}${NC}"
git log origin/$(git branch --show-current)..HEAD --oneline

# Run gates if package.json exists
if [[ -f "package.json" ]]; then
  echo -e "\n${BLUE}🔍 Running gates...${NC}"
  
  if grep -q '"lint"' package.json; then
    echo "  → Lint..."
    npm run lint --silent || { echo -e "${RED}❌ Lint failed${NC}"; exit 1; }
  fi
  
  if grep -q '"typecheck"' package.json; then
    echo "  → Typecheck..."
    npm run typecheck --silent || { echo -e "${RED}❌ Typecheck failed${NC}"; exit 1; }
  fi
  
  if grep -q '"test"' package.json; then
    echo "  → Tests..."
    npm test --silent || { echo -e "${RED}❌ Tests failed${NC}"; exit 1; }
  fi
  
  echo -e "${GREEN}✅ Gates passed${NC}"
fi

# Smart review
echo -e "\n${BLUE}🤖 Smart Review...${NC}"

DIFF=$(git diff origin/$(git branch --show-current)..HEAD)

if [[ -z "$DIFF" ]]; then
  echo -e "${GREEN}✅ No changes to review${NC}"
  git push "$@"
  exit 0
fi

REVIEW=$(opencode run -m openai/gpt-5.2-codex -p "
You are a code reviewer helping a CS/ML student learn while shipping fast.

Review this git diff and categorize ALL changes:

\`\`\`diff
$DIFF
\`\`\`

## Your Task

Categorize every file into ONE of these tiers:

### MUST_REVIEW (Student should study these)
Files with:
- Security-related code (auth, crypto, permissions)
- New algorithms or data structures
- Complex logic (nested conditions, recursion)
- Database/API changes
- Performance-critical code
- Error handling patterns

### GLANCE (Quick 10-second look)
- Refactors that don't change behavior
- Simple bug fixes
- Config changes

### AUTO_APPROVED (Skip entirely)
- Formatting, whitespace
- Import reordering
- Comment changes
- Generated code
- Test files (unless testing complex logic)

## Output Format

If there are MUST_REVIEW files:
\`\`\`
📚 MUST_REVIEW
- filepath:lines → reason (CATEGORY)
  💡 Learn: what pattern/concept to study

👀 GLANCE
- filepath → reason

✅ AUTO_APPROVED: X files (types)
\`\`\`

If nothing critical:
\`\`\`
✅ SAFE TO PUSH - No critical changes
(list what was auto-approved)
\`\`\`

Be concise. Focus on LEARNING OPPORTUNITIES.
" 2>/dev/null)

echo -e "\n$REVIEW"

# Check if needs human review
if echo "$REVIEW" | grep -q "MUST_REVIEW"; then
  echo -e "\n${YELLOW}═══════════════════════════════════════════════════${NC}"
  echo -e "${YELLOW}  Review the files above before pushing!${NC}"
  echo -e "${YELLOW}═══════════════════════════════════════════════════${NC}"
  echo ""
  read -p "Type 'push' after reviewing, or anything else to abort: " confirm
  if [[ "$confirm" != "push" ]]; then
    echo -e "${RED}Aborted.${NC}"
    exit 1
  fi
fi

# Push
echo -e "\n${BLUE}🚀 Pushing...${NC}"
git push "$@"
echo -e "${GREEN}✅ Pushed successfully!${NC}"
