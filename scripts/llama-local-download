#!/usr/bin/env bash
set -euo pipefail

model_dir="${LLAMA_CPP_MODEL_DIR:-$HOME/Models/llama.cpp}"
model_name="${LLAMA_CPP_MODEL_NAME:-Qwen2.5-7B-Instruct-Q4_K_M.gguf}"
model_url="${LLAMA_CPP_MODEL_URL:-https://huggingface.co/bartowski/Qwen2.5-7B-Instruct-GGUF/resolve/main/Qwen2.5-7B-Instruct-Q4_K_M.gguf}"
min_bytes="${LLAMA_CPP_MODEL_MIN_BYTES:-4000000000}"
out="$model_dir/$model_name"

if [[ ${1:-} == "-h" || ${1:-} == "--help" ]]; then
  cat <<'EOF'
Usage:
  llama-local-download

Downloads the default local GGUF model if missing. Safe to rerun; partial downloads resume.

Environment:
  LLAMA_CPP_MODEL_DIR   Default: ~/Models/llama.cpp
  LLAMA_CPP_MODEL_NAME  Default: Qwen2.5-7B-Instruct-Q4_K_M.gguf
  LLAMA_CPP_MODEL_URL   Override Hugging Face download URL
  LLAMA_CPP_MODEL_MIN_BYTES  Existing file is complete above this size, default 4000000000
EOF
  exit 0
fi

mkdir -p "$model_dir"

if [[ -f "$out" ]] && (( $(stat -c '%s' "$out" 2>/dev/null || echo 0) >= min_bytes )); then
  echo "$out"
  exit 0
fi

if command -v wget >/dev/null 2>&1; then
  wget -c -O "$out" "$model_url"
elif command -v curl >/dev/null 2>&1; then
  curl -L --continue-at - --output "$out" "$model_url"
else
  echo "llama-local-download: missing wget/curl" >&2
  exit 1
fi

echo "$out"
