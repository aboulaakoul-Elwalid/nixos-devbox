#!/usr/bin/env bash

# Run the Omarchy screensaver using random effects from TTE.

set -euo pipefail

screensaver_in_focus() {
  hyprctl activewindow -j | jq -e '.class == "org.omarchy.screensaver"' >/dev/null 2>&1
}

exit_screensaver() {
  hyprctl keyword cursor:invisible false &>/dev/null || true
  # Nix wraps binaries, so the running process name is often ".tte-wrapped"
  # and may not match `pkill -x tte`. Track the PID and also kill by argv.
  if [[ -n "${tte_pid:-}" ]]; then
    kill -TERM "$tte_pid" 2>/dev/null || true
    wait "$tte_pid" 2>/dev/null || true
  fi
  pkill -f 'terminaltexteffects.*branding/screensaver\.txt' 2>/dev/null || true
  pkill -f org.omarchy.screensaver 2>/dev/null || true
  exit 0
}

# Exit the screensaver on signals and input from keyboard and mouse
trap exit_screensaver SIGINT SIGTERM SIGHUP SIGQUIT

printf '\033]11;rgb:00/00/00\007'  # Set background color to black

hyprctl keyword cursor:invisible true &>/dev/null

fps="${OMARCHY_SCREENSAVER_FPS:-60}"

while true; do
  tte -i ~/.config/omarchy/branding/screensaver.txt \
    --frame-rate "$fps" --canvas-width 0 --canvas-height 0 --reuse-canvas --anchor-canvas c --anchor-text c \
    --random-effect --exclude-effects dev_worm \
    --no-eol --no-restore-cursor &
  tte_pid=$!

  # Stay alive while the animation is alive; exit on any input or focus loss.
  while kill -0 "$tte_pid" 2>/dev/null; do
    if read -r -n1 -t 1; then
      exit_screensaver
    fi
    if ! screensaver_in_focus; then
      exit_screensaver
    fi
  done

  # If TTE exits on its own, don't spin.
  sleep 0.2
done
