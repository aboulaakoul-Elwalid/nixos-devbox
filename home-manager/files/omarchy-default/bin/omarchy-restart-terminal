#!/usr/bin/env bash

if [[ -f ~/.config/alacritty/alacritty.toml ]]; then
  touch ~/.config/alacritty/alacritty.toml
fi

if pgrep -x kitty >/dev/null || pgrep -f '/kitty( |$)' >/dev/null; then
  pkill -USR1 -x kitty >/dev/null 2>&1 || true
  pkill -USR1 -f '/kitty( |$)' >/dev/null 2>&1 || true
fi

if pgrep -x ghostty >/dev/null || pgrep -f '/ghostty( |$)' >/dev/null; then
  pkill -USR2 -x ghostty >/dev/null 2>&1 || true
  pkill -USR2 -f '/ghostty( |$)' >/dev/null 2>&1 || true
fi
